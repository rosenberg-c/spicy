{
  "bin": {
    "ask": "ask",
    "tutor": "tutor",
    "explain": "explain",
    "gitmessage": "gitmessage",
    "ctx_edit": "v-edit"
  },
  "default_model": "openai/gpt-5.4",
  "models": {
    "ask": "anthropic/claude-3-opus"
  },
  "ui": {
    "ask": {
      "output": "float",
      "float_opts": {
        "relative": "editor",
        "width": 0.8,
        "height": 0.6,
        "border": "rounded",
        "title": " Spicy Ask ",
        "title_pos": "center"
      },
      "syntax": "markdown",
      "show_spinner": true,
      "auto_close": false
    },
    "tutor": {
      "output": "buffer",
      "auto_save": true,
      "save_dir": "~/tutorials",
      "auto_open": true,
      "markdown_preview": false
    },
    "explain": {
      "output": "buffer",
      "auto_save": true,
      "save_dir": "~/explanations",
      "side_by_side": false,
      "show_line_numbers": true,
      "context_max_chars": 3000,
      "context_surround_lines": 80
    },
    "gitmessage": {
      "output": "float",
      "auto_copy": true,
      "float_opts": {
        "relative": "editor",
        "width": 0.6,
        "height": 0.4,
        "border": "rounded",
        "title": " Git Commit Message "
      },
      "conventional_commits": true,
      "show_diff": true,
      "auto_insert": false
    },
    "ctx_edit": {
      "show_spinner": true
    }
  },
  "verbose": false,
  "timeout": 300000,
  "history": {
    "enabled": true,
    "max_entries": 100,
    "save_to_file": true,
    "file_path": "~/.local/share/nvim/spicy_history.json"
  },
  "telescope": {
    "enabled": true,
    "theme": "dropdown"
  },
  "statusline": {
    "enabled": false,
    "show_running": true,
    "show_last_result": false
  }
}
